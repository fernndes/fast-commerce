{
  "name": "fast-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../.. run build:shell",
    "dev": "next dev",
    "dev:local-components": "npm --prefix ../.. run build:shell && npm --prefix ../.. run copy:app-components && next dev",
    "prebuild": "npm --prefix ../.. run build:shell",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-alias.mjs ./scripts/check-banner-links.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.12",
    "@repo/app-shell": "file:../../packages/app-shell",
    "@sentry/nextjs": "^10.69.0",
    "@stencil/react-output-target": "^1.4.2",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
