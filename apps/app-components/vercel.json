{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/shell/(latest|v/.+)/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Timing-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
